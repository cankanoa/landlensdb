{
  "file_glob": "/path/to/rasters/**/*.@(tif|tiff|vrt|img|jp2|TIF|TIFF|VRT|IMG|JP2)",
  "name": "file.name",
  "image_url": "file.path",
  "geometry": "bounds_from_image",
  "metadata": {
    "raster": {
      "width": "raster.width",
      "height": "raster.height",
      "bands": "raster.bands",
      "projection": "raster.projection",
      "geotransform": "raster.geotransform",
      "format": "raster.format"
    }
  },
  "thumbnail": {
    "enabled": true,
    "width": 256,
    "height": 256,
    "resampling": "lanczos"
  },
  "fingerprint": {
    "enabled": false,
    "mode": "robust"
  }
}
